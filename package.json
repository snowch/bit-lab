{
  "name": "bit-lab",
  "author": "Christopher Snow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "How computers represent and process data.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "platform/*",
    "content"
  ],
  "scripts": {
    "dev": "npm run dev -w @bl/course",
    "build": "npm run build -w @bl/course",
    "preview": "npm run preview -w @bl/course",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:educational": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && node scripts/sync-platform.mjs --check && npm run typecheck && npm test && npm run build && npm run test:educational"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
